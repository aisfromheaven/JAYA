<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 500 500" width="100%" height="100%" fill="none">
  <!-- JYB Isometric Hexagon Flat Vector Logo - Transparent Background -->
  <g fill="currentColor">
    <!-- Letter J (Left Facet) -->
    <path d="M 85 162 
             L 215 237 
             L 215 390 
             L 190 405 
             L 115 362 
             L 115 285 
             L 150 305 
             L 150 338 
             L 182 356 
             L 182 256 
             L 85 200 Z" />

    <!-- Letter Y (Top Facet & Center Stem) -->
    <!-- Top Face of Y -->
    <path d="M 250 65 
             L 375 137 
             L 250 210 
             L 125 137 Z 
             M 250 115 
             L 185 152 
             L 250 190 
             L 315 152 Z" 
          fill-rule="evenodd" />

    <!-- Vertical Stem of Y -->
    <path d="M 233 226 
             L 267 226 
             L 267 428 
             L 250 438 
             L 233 428 Z" />

    <!-- Letter B (Right Facet) -->
    <path d="M 285 237 
             L 415 162 
             L 415 325 
             L 385 342 
             L 415 360 
             L 415 390 
             L 285 465 
             L 285 237 Z 
             M 318 275 
             L 382 238 
             L 382 288 
             L 318 325 Z 
             M 318 355 
             L 382 318 
             L 382 368 
             L 318 405 Z" 
          fill-rule="evenodd" />
  </g>
</svg>
